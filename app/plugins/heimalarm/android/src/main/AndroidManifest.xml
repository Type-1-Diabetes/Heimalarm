<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updates: APK von GitHub laden und den Android-Installationsdialog öffnen -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 17+: Zugriff aufs Heimnetz (Zentrale ws://…:9001, PC :8765, WLAN-Geräte) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Alarm am Handy: Vollbild-Meldung (Sperrbildschirm), Vibration, nach Neustart wieder starten -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Bei Alarm: Alarm-App aus dem Hintergrund öffnen (nur wenn erlaubt), „Nicht stören“ durchbrechen, Bildschirm an -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+: andere Apps finden, um die Alarm-App zu starten -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Updates: den Paketinstaller finden, damit kein „Öffnen mit“ erscheint -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <!-- Unverschlüsseltes http/ws für Geräte im Heimnetz (Zentrale, PC, WLAN-Geräte) – auch in signierten Builds.
         Android kann das nicht auf private IP-Bereiche begrenzen (nur Hostnamen), darum für alle. -->
    <application
        android:networkSecurityConfig="@xml/heimalarm_network"
        tools:replace="android:networkSecurityConfig">
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.heimalarm.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/heimalarm_update_paths" />
        </provider>

        <!-- Hält die App im Hintergrund am Leben, damit Alarme ankommen -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Empfang von Einsatz-Alarmen im Heimnetz" />
        </service>

        <!-- Knopf „Stopp“ in der Alarm-Mitteilung -->
        <receiver android:name=".StopReceiver" android:exported="false" />

        <!-- Nach Neustart/Update den Hintergrund-Dienst wieder starten -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A1/A6 – liest Alarm-Benachrichtigungen von SYBOS/aPager mit -->
        <service
            android:name=".AlarmListener"
            android:exported="true"
            android:label="Heimalarm"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
