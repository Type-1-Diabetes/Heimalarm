<?xml version="1.0" encoding="utf-8"?>
<!-- Heimnetz ohne TLS: Zentrale (ws://…:9001), PC-Kopplung (http://…:8765), Shelly/Hue/WLED/Tasmota.
     Öffentliche Dienste (Divera, aPager, GitHub, Voice Monkey) nutzen ohnehin https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
