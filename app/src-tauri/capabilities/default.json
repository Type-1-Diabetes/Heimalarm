{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte der Oberfläche",
  "windows": [
    "main",
    "takeover-*",
    "tv-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-fullscreen",
    "notification:default",
    "opener:default",
    "heimalarm:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.divera247.com/*"
        },
        {
          "url": "https://divera247.com/*"
        },
        {
          "url": "https://alamos-backend.ey.r.appspot.com/*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "http://*:*/*"
        },
        {
          "url": "https://api-v3.voicemonkey.io/*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "https://api.github.com/repos/Type-1-Diabetes/Heimalarm/*"
        },
        {
          "url": "https://api.github.com/repos/DanieldamHH112/Heimalarm/*"
        }
      ]
    }
  ]
}
